# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# App
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-prod
DATABASE_URL=sqlite:///bookings.db

# Business
BUSINESS_NAME=Demo Spa
TIMEZONE=Asia/Singapore

# Coaches (SQLite). Optional: seed exactly one demo coach with a personal Telegram bot token.
# Never commit real tokens. After pasting a token in chat, rotate it in @BotFather.
# COACH_SIMULATION_BOT_TOKEN=
# COACH_SIMULATION_ID=deerflow-coach
# COACH_SIMULATION_NAME=Deerflow Coach
# COACH_SIMULATION_PHONE=

# OpenWA WhatsApp Gateway (alternative to Telegram)
# Set messaging.channel = "whatsapp" in config/config.json to enable
OPENWA_GATEWAY_URL=http://127.0.0.1:2785
OPENWA_API_KEY=dev-admin-key
OPENWA_SESSION_NAME=main